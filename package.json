{
  "name": "cloudflare-site-template",
  "version": "1.0.0",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "verify": "npm run check && npm run test && npm run build && npm run test:dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jleavers/cloudflare-site-template.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/jleavers/cloudflare-site-template/issues"
  },
  "homepage": "https://github.com/jleavers/cloudflare-site-template#readme",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.19.2",
    "jsonc-parser": "3.3.1",
    "node-html-parser": "9.0.4",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
