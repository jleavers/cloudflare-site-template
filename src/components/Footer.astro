---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="border-t border-line text-sm text-muted">
  <div class="mx-auto grid max-w-6xl gap-8 px-6 py-12 md:grid-cols-12 md:gap-12 md:py-16">
    <div class="md:col-span-5">
      <p class="flex items-center gap-3 font-display text-xl text-ink">
        <img src="/favicon.svg" alt="" width="24" height="24" class="size-6" />
        {site.name}
      </p>
      <p class="mt-4">© {year} {site.legal.companyName}</p>
      {site.legal.registration && <p class="mt-1">{site.legal.registration}</p>}
      {site.legal.address && <p class="mt-1">{site.legal.address}</p>}
    </div>
    <nav aria-label="Footer" class="flex flex-wrap content-start gap-x-8 gap-y-3 md:col-span-7 md:pt-1.5">
      {
        [...site.nav.footer, ...site.socials].map((link) => (
          <a href={link.href} class="font-medium underline-offset-4 hover:text-ink hover:underline">
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
