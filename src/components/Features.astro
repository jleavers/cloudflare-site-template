---
interface Props {
  id: string;
  heading: string;
  intro?: string;
  items: { title: string; body: string }[];
}
const { id, heading, intro, items } = Astro.props;
---
<section id={id} class="scroll-mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-x-12 gap-y-12 px-6 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-5">
      <h2 class="text-4xl leading-tight tracking-tight text-balance md:text-5xl">{heading}</h2>
      {intro && <p class="mt-5 max-w-md text-lg leading-relaxed text-pretty text-muted">{intro}</p>}
    </div>
    <ul class="md:col-span-7">
      {
        items.map((item) => (
          <li class="border-t border-line py-8 first:border-t-0 first:pt-0 last:pb-0 md:py-10">
            <h3 class="text-2xl md:text-[1.75rem]">{item.title}</h3>
            <p class="mt-3 max-w-xl text-lg leading-relaxed text-pretty text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
