---
interface Props {
  id: string;
  heading: string;
  items: { question: string; answer: string }[];
}
const { id, heading, items } = Astro.props;
---
<section id={id} class="scroll-mt-24">
  <div class="mx-auto grid max-w-6xl gap-x-12 gap-y-10 px-6 py-20 md:grid-cols-12 md:py-28">
    <h2 class="text-4xl leading-tight tracking-tight text-balance md:col-span-5 md:text-5xl">{heading}</h2>
    <div class="border-t border-line md:col-span-7">
      {
        items.map((item) => (
          <details class="group border-b border-line">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-6 font-display text-[1.375rem] leading-snug [&::-webkit-details-marker]:hidden">
              {item.question}
              <span
                aria-hidden="true"
                class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full border border-line text-brand group-hover:border-brand motion-safe:transition-transform group-open:rotate-45"
              >
                <svg viewBox="0 0 14 14" class="size-3.5">
                  <path d="M7 1v12M1 7h12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="max-w-xl pr-14 pb-7 text-lg leading-relaxed text-pretty text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
