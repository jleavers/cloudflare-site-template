---
import { site } from '../config/site';
// The mark is the favicon, so a site that replaces public/favicon.svg updates both.
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-3.5">
    <a href="/" class="flex items-center gap-3 font-display text-xl text-ink">
      <img src="/favicon.svg" alt="" width="28" height="28" class="size-7" />
      {site.name}
    </a>
    <nav aria-label="Main" class="hidden items-center gap-9 md:flex">
      {
        site.nav.header.map((link) => (
          <a href={link.href} class="text-[0.9375rem] font-medium text-muted underline-offset-[6px] hover:text-ink hover:underline">
            {link.label}
          </a>
        ))
      }
    </nav>
    <details class="group relative md:hidden" data-mobile-nav>
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
      >
        Menu
        <svg aria-hidden="true" viewBox="0 0 12 12" class="size-3 text-brand motion-safe:transition-transform group-open:rotate-180">
          <path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </summary>
      <nav aria-label="Mobile" class="absolute right-0 mt-3 flex w-60 flex-col rounded-card border border-line bg-paper p-2 shadow-xl shadow-ink/10">
        {site.nav.header.map((link) => <a href={link.href} class="rounded-xl px-4 py-3 font-medium text-ink hover:bg-line/50">{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
