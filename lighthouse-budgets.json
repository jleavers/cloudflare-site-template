{
  "runs": 3,
  "paths": ["/", "/privacy/"],
  "chromeFlags": ["--headless=new", "--no-sandbox"],
  "assertions": {
    "base": {
      "unsized-images": { "level": "error", "maxLength": 0 },
      "render-blocking-insight": { "level": "error", "minScore": 1 },
      "cumulative-layout-shift": { "level": "error", "maxNumericValue": 0.01 },
      "total-byte-weight": { "level": "error", "maxNumericValue": 307200 },
      "font-display-insight": { "level": "error", "minScore": 1 },
      "categories:accessibility": { "level": "error", "minScore": 0.95 },
      "categories:seo": { "level": "error", "minScore": 1 }
    },
    "local": {
      "categories:performance": { "level": "error", "minScore": 1 },
      "categories:best-practices": { "level": "error", "minScore": 0.95 }
    },
    "ci": {
      "categories:performance": { "level": "warn", "minScore": 0.9 },
      "categories:best-practices": { "level": "warn", "minScore": 0.95 }
    }
  }
}
